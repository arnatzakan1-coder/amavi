# ───── Required ─────
# Local: SQLite file. Production: Turso (libsql://<db>.turso.io) + DATABASE_AUTH_TOKEN.
# On Vercel the Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead — both work.
DATABASE_URL="file:./data/amavi.db"
DATABASE_AUTH_TOKEN=""

# Random 32+ chars: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Public site URL (used for payment return links)
APP_URL="http://localhost:3000"

# Emails that become ADMIN on registration (comma separated)
ADMIN_EMAILS="admin@amavi.kz"

# ───── Optional: social sign-in (buttons appear only when set) ─────
# Google: console.cloud.google.com → OAuth client → redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Apple: developer.apple.com → Sign in with Apple → return URL: <APP_URL>/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ───── Optional: 2GIS interactive map (dev.2gis.com) ─────
NEXT_PUBLIC_2GIS_API_KEY=""

# ───── Online payments (adapters in src/lib/payments.ts must be implemented first) ─────
KASPI_MERCHANT_ID=""
KASPI_API_KEY=""
KASPI_WEBHOOK_SECRET=""
HALYK_EPAY_CLIENT_ID=""
HALYK_EPAY_CLIENT_SECRET=""
HALYK_EPAY_TERMINAL_ID=""
CARD_GATEWAY_PUBLIC_KEY=""
CARD_GATEWAY_SECRET=""
CARD_GATEWAY_WEBHOOK_SECRET=""
